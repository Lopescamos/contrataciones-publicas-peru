# =============================================================================
# Plantilla de variables de entorno.
# Copia este archivo como ".env" y completa los valores. El archivo .env NUNCA
# se sube a Git (está en .gitignore). Las variables vacías usan el valor por
# defecto definido en config/*.yaml.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Perfil activo: local_sqlite | local_postgres | cloud_postgres | custom_url
DB_PROFILE=local_sqlite

# PostgreSQL local (docker compose up -d)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=contrataciones
PG_USER=analytics
PG_PASSWORD=cambia_esta_clave
PG_SCHEMA=public

# PostgreSQL en la nube (Supabase, Neon, Google Cloud SQL, AWS RDS, Azure...)
CLOUD_PG_HOST=
CLOUD_PG_PORT=5432
CLOUD_PG_DATABASE=postgres
CLOUD_PG_USER=
CLOUD_PG_PASSWORD=
CLOUD_PG_SCHEMA=public
CLOUD_PG_SSLMODE=require

# Alternativa: URL completa de SQLAlchemy (perfil custom_url)
# Ejemplo: postgresql+psycopg2://usuario:clave@host:5432/base
DATABASE_URL=

# --- APIs ----------------------------------------------------------------------
# API OCDS del OECE (ex OSCE). Endpoint: records (por mes) | releases
OECE_API_BASE_URL=https://contratacionesabiertas.oece.gob.pe/api/v1
OECE_API_ENDPOINT=records
OECE_API_SOURCE_ID=seace_v3
# Algunos servidores del Estado rechazan clientes sin User-Agent de navegador.
HTTP_USER_AGENT=

# API de series estadísticas del BCRP (tipo de cambio)
BCRP_API_BASE_URL=https://estadisticas.bcrp.gob.pe/estadisticas/series/api

# --- Ejecución -----------------------------------------------------------------
LOG_LEVEL=INFO
